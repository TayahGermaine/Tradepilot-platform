# Copy this file to .env and fill in real values. Never commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your Vite dev server / deployed frontend)
CORS_ORIGIN=http://localhost:5173

# MongoDB
# Local:    mongodb://127.0.0.1:27017/tradepilot
# Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradepilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tradepilot

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed script (npm run seed) — creates the first admin account
SEED_ADMIN_EMAIL=admin@tradepilot.io
SEED_ADMIN_PASSWORD=AdminSecure2026!
SEED_ADMIN_NAME=System Administrator
